# Serviço do systemd: sobe o projeto sozinho quando a Raspberry liga.
#
# Ajuste User e os caminhos conforme o seu usuário na Pi, depois:
#   sudo cp replay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now replay.service
#   journalctl -u replay.service -f      # para ver os logs
[Unit]
Description=Replay de quadra (clipquadras)
After=network.target

[Service]
Type=simple
User=pi
SupplementaryGroups=video
WorkingDirectory=/home/pi/replay-quadra
ExecStart=/home/pi/replay-quadra/.venv/bin/python -m app.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
